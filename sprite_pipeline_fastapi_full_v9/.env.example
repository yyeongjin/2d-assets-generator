# API (V9 is fail-closed: API_TOKEN must be set unless the explicit local-only override is enabled.)
API_TOKEN=replace-with-a-long-random-token
ALLOW_UNAUTHENTICATED_API=false
SPRITE_PIPELINE_ROOT=/workspace/sprite-pipeline
SPRITE_WORKER_READ_TIMEOUT_SECONDS=1800
KIMODO_WORKER_URL=http://127.0.0.1:9101
OTA_WORKER_URL=http://127.0.0.1:9102
SPRITE_JOBS_ROOT=/workspace/sprite-pipeline/jobs
SPRITE_RUN_DIR=/workspace/sprite-pipeline/run
SPRITE_LOG_DIR=/workspace/sprite-pipeline/logs
SPRITE_STARTUP_TIMEOUT_SECONDS=900
# Set false on an animal-only Pod. Character requests will report character_ready=false.
START_KIMODO=true

# Kimodo
KIMODO_MODEL=Kimodo-SOMA-RP-v1.1
# Stable default: repository-shipped 05_root_path motion fixture.
KIMODO_MOTION_SOURCE=official_example
# Optional fixture override. V8 normalizes missing derived arrays into each job copy.
# KIMODO_OFFICIAL_WALK_MOTION=/workspace/sprite-pipeline/kimodo/kimodo/assets/demo/examples/kimodo-soma-rp/05_root_path/motion.npz
# KIMODO_OFFICIAL_WALK_META=/workspace/sprite-pipeline/kimodo/kimodo/assets/demo/examples/kimodo-soma-rp/05_root_path/meta.json
# For a frozen generated candidate use KIMODO_MOTION_SOURCE=fixture and set:
# KIMODO_FIXTURE_LABEL=generated-neutral-walk-seed-42
# KIMODO_FIXTURE_MOTION=/workspace/sprite-pipeline/fixtures/v8/neutral_walk_seed_42.npz
# KIMODO_FIXTURE_META=/workspace/sprite-pipeline/fixtures/v8/neutral_walk_seed_42.meta.json

# Generated-mode production candidate settings.
KIMODO_DENSE_ROOT_CONSTRAINT=true
KIMODO_GENERATED_DURATION=4.0
KIMODO_MAX_MOTION_ATTEMPTS=8

# Character path: V8 Motion Adapter is preserved unchanged. V9 animals bypass Kimodo and this human adapter.
SPRITE_CANONICAL_HEADING_TOLERANCE_DEG=1.0
SPRITE_FRONT_BACK_TORSO_YAW_LIMIT_DEG=2.5
SPRITE_FRONT_BACK_HEAD_YAW_LIMIT_DEG=5.0
# 0 = upper-arm point only, 1 = clavicle point only.
SPRITE_BODY18_SHOULDER_BLEND=0.35

# One-to-All defaults. Keep these first; geometry corrections happen before OTA.
OTA_BLACK_POSE_CFG=true
OTA_FRONT_BACK_IMAGE_GUIDANCE_SCALE=2.5
OTA_FRONT_BACK_POSE_GUIDANCE_SCALE=1.5
OTA_SIDE_IMAGE_GUIDANCE_SCALE=2.5
OTA_SIDE_POSE_GUIDANCE_SCALE=1.5

# V9 animal guidance. Higher image guidance and lower pose guidance reduce
# species drift while retaining the synthetic quadruped / creature cycle.
OTA_ANIMAL_FRONT_BACK_IMAGE_GUIDANCE_SCALE=3.25
OTA_ANIMAL_FRONT_BACK_POSE_GUIDANCE_SCALE=1.05
OTA_ANIMAL_SIDE_IMAGE_GUIDANCE_SCALE=3.35
OTA_ANIMAL_SIDE_POSE_GUIDANCE_SCALE=1.15
OTA_BIPED_ANIMAL_IMAGE_GUIDANCE_SCALE=3.10
OTA_BIPED_ANIMAL_POSE_GUIDANCE_SCALE=1.20

# Optional checkpoint A/B override:
# OTA_CHECKPOINT_DIR=/workspace/sprite-pipeline/one-to-all/checkpoints/One-to-All-1.3b_1

# V9 stabilization: characters retain BODY_18 anchors; animal jobs use foreground silhouette anchors and never call the human pose detector.
OTA_STABILIZE_RENDERED_FRAMES=true
OTA_STABILIZE_MAX_SHIFT_RATIO=0.08
OTA_STABILIZE_SMOOTHING=0.35
OTA_STABILIZE_MIN_VALID_FRACTION=0.60

# Shared-palette appearance stabilization retained from V8.
# The four input directions define one character palette. Hue/chroma are pulled
# toward that palette; brightness is corrected weakly so natural shading remains.
SPRITE_APPEARANCE_STABILIZE=true
SPRITE_APPEARANCE_QC_STRICT=true
SPRITE_APPEARANCE_PALETTE_SIZE=12
SPRITE_APPEARANCE_CHROMA_STRENGTH=0.55
SPRITE_APPEARANCE_BRIGHTNESS_STRENGTH=0.18
SPRITE_APPEARANCE_CONTRAST_STRENGTH=0.16
SPRITE_APPEARANCE_MAX_DELTA_E=14.0
SPRITE_APPEARANCE_TEMPORAL_CHROMA_STRENGTH=0.38
SPRITE_APPEARANCE_TEMPORAL_LUMA_STRENGTH=0.16
SPRITE_APPEARANCE_MAX_TEMPORAL_CHROMA_SPREAD=13.0
SPRITE_APPEARANCE_MAX_TEMPORAL_LUMA_SPREAD=12.0
SPRITE_APPEARANCE_MAX_MEAN_CORRECTION_DELTA_E=9.0

# V9 rendered-loop controls and animal semantic hard gate.
# Candidate selection still compares even_start, odd, and even_end across all
# four directions. V8 additionally checks foreground centroid, ground line,
# body height, and color closure at 8→1.
OTA_LOOP_MAX_ATTEMPTS=2
OTA_LOOP_SEED_STRIDE=100003
SPRITE_LOOP_QC_STRICT=true
SPRITE_LOOP_MAX_SEAM_RATIO=1.45
SPRITE_LOOP_MAX_MEAN_SEAM_RATIO=1.20
SPRITE_LOOP_MAX_TRANSITION_RATIO=2.25
SPRITE_LOOP_MAX_FRONT_BACK_CENTROID_SEAM_RATIO=0.011
SPRITE_LOOP_MAX_FRONT_BACK_GROUND_SEAM_RATIO=0.011
SPRITE_LOOP_MAX_FRONT_BACK_HEIGHT_SEAM_RATIO=0.025
SPRITE_LOOP_MAX_COLOR_SEAM_DELTA_E=12.0

# Animal identity/topology QC is strict by default. Failed artifacts remain available at /v1/jobs/{job_id}/debug.
SPRITE_ANIMAL_QC_STRICT=true

# V9 animal motion input contract
# Multipart motion_npz is accepted only for quadruped/biped_animal routes.
# The server validates animal-motion-v1 NPZ files up to 64 MiB before queueing.
SPRITE_ANIMAL_MOTION_NPZ_MAX_BYTES=67108864
SPRITE_ANIMAL_MOTION_NPZ_MAX_UNCOMPRESSED_BYTES=268435456
SPRITE_ANIMAL_MOTION_NPZ_MAX_MEMBERS=64
